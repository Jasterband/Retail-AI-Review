# 本地默认 SQLite；上线改为 RDS Postgres
DATABASE_URL=sqlite:///./retail_meeting_check.db

# PE 调用鉴权（Bearer Token）；逗号分隔多个
API_TOKENS=dev-token-change-me

# 可选：回调 HMAC 密钥
CALLBACK_HMAC_SECRET=

# ---------- 多模态（MyGenAssist / 公司网关，OpenAI 兼容）----------
# 把 KEY 换成你在 MyGenAssist / ALICN 申请的 Token（不要用公网 OpenAI Key）
OPENAI_API_KEY=
# 公司网关 Base（不要带 /chat/completions；代码会自动拼）
OPENAI_BASE_URL=https://chat.int.alicn.bayer.cn/api/v2
# 双模型：OCR/通用 vs 全景数人（空则回退到 VISION_MODEL）
# 推荐：OCR 用 qwen3.5-ocr；数人用 qwen3.5-flash
VISION_MODEL=qwen3.5-flash
VISION_OCR_MODEL=qwen3.5-ocr
VISION_COUNT_MODEL=qwen3.5-flash
# 备选示例：qwen3.7-plus / qwen3.8-max / gpt-4-turbo（若网关已开通）
VISION_TIMEOUT_SEC=180
# 手册当期年份（无旧版负样本时用封面年份判定）
HANDBOOK_CURRENT_YEAR=2026

# 本地样例根目录（默认=进程 cwd，即仓库根）
LOCAL_ASSET_ROOT=
# s3_uri → 相对路径映射表
S3_LOCAL_MAP_PATH=docs/fixtures/s3_local_map.json
# 真 S3：本地 map 未命中时 boto3 GetObject（需 pip install boto3）
USE_REAL_S3=false
AWS_REGION=cn-north-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# API 限流：每 token/IP 每分钟请求数；0=关闭
RATE_LIMIT_PER_MINUTE=60

MODEL_VERSION=vision-0.1.0-mga
