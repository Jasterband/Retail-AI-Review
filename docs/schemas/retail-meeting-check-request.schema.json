{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pe.local/schemas/retail-meeting-check-request.schema.json",
  "title": "RetailMeetingCheckRequest",
  "description": "PE → AI：一场零售会议材料检查请求。AI 仅按 s3_uri 拉取材料。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "request_id",
    "meeting_id",
    "session_no",
    "project_type",
    "period_id",
    "form",
    "assets"
  ],
  "properties": {
    "request_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 64,
      "description": "幂等键；重复提交返回已有结果且不计次"
    },
    "meeting_id": {
      "type": "integer",
      "minimum": 1
    },
    "session_no": {
      "type": "string",
      "maxLength": 20
    },
    "project_type": {
      "type": "string",
      "enum": ["LECTURE_HALL", "MICRO"]
    },
    "meeting_subtype": {
      "type": ["string", "null"],
      "enum": ["SINGLE", "DUAL", null],
      "description": "MICRO 必填；LECTURE_HALL 为 null"
    },
    "period_id": {
      "type": "integer",
      "minimum": 1
    },
    "form": {
      "$ref": "#/$defs/MeetingForm"
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/AssetItem"
      }
    },
    "refs": {
      "$ref": "#/$defs/Refs"
    },
    "options": {
      "$ref": "#/$defs/Options"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "project_type": { "const": "MICRO" } }
      },
      "then": {
        "required": ["meeting_subtype"],
        "properties": {
          "meeting_subtype": {
            "type": "string",
            "enum": ["SINGLE", "DUAL"]
          }
        }
      }
    }
  ],
  "$defs": {
    "MeetingForm": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "meeting_name",
        "meeting_date",
        "start_time",
        "end_time",
        "chain_or_store_name",
        "location",
        "total_attendees",
        "speakers"
      ],
      "properties": {
        "meeting_name": { "type": "string", "maxLength": 50 },
        "meeting_date": {
          "type": "string",
          "format": "date",
          "description": "YYYY-MM-DD"
        },
        "start_time": {
          "type": "string",
          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
          "description": "HH:mm"
        },
        "end_time": {
          "type": "string",
          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
        },
        "chain_or_store_name": {
          "type": "string",
          "maxLength": 50,
          "description": "大讲堂=连锁名；微型=药店名"
        },
        "location": {
          "type": "string",
          "maxLength": 200,
          "description": "会议地点；与海报/水印 OCR 地点比对"
        },
        "remark": { "type": ["string", "null"], "maxLength": 200 },
        "total_attendees": { "type": "integer", "minimum": 0 },
        "speakers": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/Speaker" }
        }
      }
    },
    "Speaker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "speaker_id",
        "speaker_name",
        "topic",
        "store_name",
        "service_minutes"
      ],
      "properties": {
        "speaker_id": { "type": "integer", "minimum": 1 },
        "role_title": { "type": "string", "maxLength": 10 },
        "store_name": { "type": "string", "maxLength": 50 },
        "speaker_name": { "type": "string", "maxLength": 20 },
        "topic": { "type": "string", "maxLength": 50 },
        "service_minutes": { "type": "integer", "minimum": 1 },
        "fee": { "type": "number" },
        "tax": { "type": ["number", "null"] }
      }
    },
    "AssetItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asset_id", "asset_type", "s3_uri", "content_type"],
      "properties": {
        "asset_id": { "type": "integer", "minimum": 1 },
        "asset_type": {
          "type": "string",
          "enum": [
            "E_POSTER",
            "POSTER",
            "STAND",
            "NAME_CARD",
            "HANDBOOK",
            "SPEAKER_PHOTO",
            "PANORAMA",
            "SIGNIN",
            "E_POSTER_DISPLAY",
            "PROJECT_INTRO_DISPLAY"
          ]
        },
        "s3_uri": {
          "type": "string",
          "pattern": "^s3://[\\w.\\-]+/.+",
          "description": "s3://bucket/key"
        },
        "content_type": {
          "type": "string",
          "enum": ["image/jpeg", "image/png", "image/jpg", "application/pdf"]
        },
        "sort_no": { "type": "integer", "minimum": 1, "default": 1 },
        "speaker_id": { "type": ["integer", "null"], "minimum": 1 },
        "speaker_shot_kind": {
          "type": ["string", "null"],
          "enum": ["TITLE_GROUP", "LECTURING", null]
        }
      }
    },
    "Refs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "template_pack_version": {
          "type": "string",
          "description": "如 2026Q2；空则用当期默认 active pack"
        },
        "logo_ref_s3": { "type": "string", "pattern": "^s3://.+" },
        "topic_search_scope": {
          "type": "string",
          "enum": ["period", "all"],
          "default": "period",
          "description": "跨会议主题查重范围；兼容旧字段名 duplicate_search_scope"
        },
        "image_dup_search_scope": {
          "type": "string",
          "enum": ["period", "all"],
          "default": "period",
          "description": "跨会议图片混用检索范围"
        },
        "duplicate_search_scope": {
          "type": "string",
          "enum": ["period", "all"],
          "default": "period",
          "description": "已弃用别名，等同 topic_search_scope"
        }
      }
    },
    "Options": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "clarity_threshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.6
        },
        "human_confidence_threshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.75
        },
        "watermark_time_skew_minutes": {
          "type": "integer",
          "minimum": 0,
          "default": 120,
          "description": "水印时间相对会议时段允许偏移（分钟）"
        },
        "name_match_mode": {
          "type": "string",
          "enum": ["exact", "fuzzy"],
          "default": "fuzzy"
        },
        "response_mode": {
          "type": "string",
          "enum": ["simple", "full"],
          "default": "simple",
          "description": "回调默认响应模式；查询可用 ?mode= 覆盖。simple=PE展示；full=AI debug"
        },
        "image_phash_max_distance": {
          "type": "integer",
          "minimum": 0,
          "default": 10,
          "description": "图片近似相似：pHash 汉明距离 ≤ 该值则判重复"
        },
        "image_similarity_threshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.92,
          "description": "图片近似相似：embedding 余弦相似度 ≥ 该值则判重复"
        }
      }
    }
  }
}
