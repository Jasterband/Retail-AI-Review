{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pe.local/schemas/retail-meeting-check-request.schema.json",
  "title": "RetailMeetingCheckRequest",
  "description": "PE → AI：与药师会交互 JSON 同构 { project, meeting, speakers, meetingPhotos }",
  "type": "object",
  "additionalProperties": true,
  "required": ["project", "meeting", "speakers"],
  "properties": {
    "project": { "$ref": "#/$defs/Project" },
    "meeting": { "$ref": "#/$defs/Meeting" },
    "speakers": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/Speaker" }
    },
    "meetingPhotos": {
      "type": "array",
      "items": { "$ref": "#/$defs/PePhoto" }
    }
  },
  "$defs": {
    "Project": {
      "type": "object",
      "additionalProperties": true,
      "required": ["projectId", "projectType"],
      "properties": {
        "projectId": { "type": "string", "minLength": 1, "maxLength": 36 },
        "projectType": { "type": "integer", "enum": [1, 2] },
        "projectName": { "type": "string" },
        "startDate": { "type": "string" },
        "endDate": { "type": "string" }
      }
    },
    "Meeting": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "meetingId",
        "meetingNo",
        "meetingName",
        "meetingType",
        "meetingDate",
        "startTime",
        "endTime",
        "meetingLocation",
        "totalAttendees"
      ],
      "properties": {
        "meetingId": { "type": "string", "minLength": 1, "maxLength": 36 },
        "meetingNo": { "type": "string", "maxLength": 20 },
        "meetingName": { "type": "string", "maxLength": 50 },
        "meetingType": { "type": "integer", "enum": [0, 1, 2] },
        "meetingTypeName": { "type": ["string", "null"] },
        "meetingDate": { "type": "string", "format": "date" },
        "startTime": { "type": "string", "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$" },
        "endTime": { "type": "string", "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$" },
        "durationMinutes": { "type": ["integer", "null"] },
        "chainName": { "type": ["string", "null"], "maxLength": 50 },
        "pharmacyName": { "type": ["string", "null"], "maxLength": 50 },
        "meetingLocation": { "type": "string", "maxLength": 200 },
        "remark": { "type": ["string", "null"], "maxLength": 200 },
        "totalAttendees": { "type": "integer", "minimum": 0 },
        "otherCost": { "type": ["number", "null"] }
      }
    },
    "Speaker": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "speakerId",
        "identityName",
        "storeName",
        "speakerName",
        "topic",
        "serviceMinutes"
      ],
      "properties": {
        "speakerId": { "type": "string", "minLength": 1, "maxLength": 36 },
        "identityName": { "type": "string", "maxLength": 10 },
        "storeName": { "type": "string", "maxLength": 50 },
        "speakerName": { "type": "string", "maxLength": 20 },
        "topic": { "type": "string", "maxLength": 50 },
        "serviceMinutes": { "type": "integer", "minimum": 1 },
        "lectureFee": { "type": ["number", "null"] },
        "tax": { "type": ["number", "null"] },
        "photos": {
          "type": "array",
          "items": { "$ref": "#/$defs/PePhoto" }
        }
      }
    },
    "PePhoto": {
      "type": "object",
      "additionalProperties": true,
      "required": ["photoId", "photoType", "photoTypeName", "fileUrl"],
      "properties": {
        "photoId": { "type": "string", "minLength": 1, "maxLength": 36 },
        "photoType": {
          "type": "string",
          "enum": [
            "EDM",
            "Poster",
            "Stand",
            "TableCard",
            "Manual",
            "EDMDisplay",
            "ProjectIntro",
            "Panorama",
            "SignSheet",
            "SpeakerTitle",
            "SpeakerLecture"
          ]
        },
        "photoTypeName": { "type": "string", "minLength": 1, "maxLength": 50 },
        "fileUrl": {
          "type": "string",
          "maxLength": 1000,
          "pattern": "^(s3|https?)://.+"
        },
        "fileName": { "type": "string" }
      }
    }
  }
}
